# PraanSewa Environment Configuration Example

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# PostgreSQL Database (Prisma ORM)
# Option A (Local Windows PostgreSQL): Replace <password> with your local postgres superuser password
# DATABASE_URL="postgresql://postgres:<YOUR_POSTGRES_PASSWORD>@localhost:5432/praansewa_db?schema=public"
# Option B (Docker Compose Postgres): uses port 5433 to avoid port 5432 conflicts
DATABASE_URL="postgresql://praan:praansewa_secret@localhost:5432/praansewa_db?schema=public"

# Authentication & Security
JWT_SECRET=praansewa_jwt_super_secret_production_key_healthcare_secure_123
JWT_REFRESH_SECRET=praansewa_jwt_refresh_super_secret_production_key_456
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# AI Configuration (Configurable Providers: "grok", "openai", "groq", "mock")
AI_PROVIDER=grok
GROK_API_KEY=
GROK_MODEL=grok-beta
GROK_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Voice Assistant (Configurable: "browser", "openai", "mock")
VOICE_STT_PROVIDER=browser
VOICE_TTS_PROVIDER=browser

# Document Storage (Cloudinary - optional/configurable, falls back to local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Notifications (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PraanSewa Healthcare <noreply@praansewa.health>"

# Payment Integration (Razorpay - optional/test mode simulation)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
