# =========================================
# AI Upchaar - Frontend & Local Dev Config
# =========================================

# Groq API Key (Recommended - Get from https://console.groq.com/keys)
VITE_GROQ_API_KEY=

# Google Gemini API Key (Alternative - Get from https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=

# Optional Backend URL (when deploying backend to Render)
# e.g. https://ai-upchaar-backend.onrender.com
VITE_API_BASE_URL=
