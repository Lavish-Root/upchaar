# ===================================================
# AI Upchaar / PraanSewa Environment Configuration
# ===================================================

# Frontend Client Configuration
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/praansewa_db?schema=public"

# Authentication & Security (JWT)
JWT_SECRET=praansewa_jwt_super_secret_production_key_healthcare_secure_123
JWT_REFRESH_SECRET=praansewa_jwt_refresh_super_secret_production_key_456
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# AI Configuration (Configurable Providers: "grok", "openai", "groq", "mock")
AI_PROVIDER=grok
GROK_API_KEY=
GROK_MODEL=grok-beta
GROK_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Voice Assistant (Configurable: "browser", "openai", "mock")
VOICE_STT_PROVIDER=browser
VOICE_TTS_PROVIDER=browser

# Document Storage (Cloudinary - optional fallback to local)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Notifications (Nodemailer / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PraanSewa Healthcare <noreply@praansewa.health>"

# Payment Integration (Razorpay - optional / simulation)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
